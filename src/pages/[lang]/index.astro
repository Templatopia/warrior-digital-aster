---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import HeroEditorial from '../../components/sections/HeroEditorial.astro';
import Philosophy from '../../components/sections/Philosophy.astro';
import Features from '../../components/sections/Features.astro';
import SuiteIndex from '../../components/sections/SuiteIndex.astro';
import ImageBand from '../../components/sections/ImageBand.astro';
import GallerySlider from '../../components/sections/GallerySlider.astro';
import CtaStatement from '../../components/sections/CtaStatement.astro';
import NextPage from '../../components/sections/NextPage.astro';
import { getPage } from '../../lib/content';
import { getLocalePaths } from '../../lib/paths';
import { nextPage } from '../../lib/i18n';
import { buildingSchema, leasingOfficeSchema } from '../../lib/schema';
import type { Locale } from '../../i18n/ui';

export const getStaticPaths = getLocalePaths;
const locale = Astro.params.lang as Locale;
const p = await getPage<any>(locale, 'home');
const amenities = await getCollection('amenities');
---
<BaseLayout locale={locale} title={p.seo.title} description={p.seo.description} schema={[buildingSchema(locale, amenities), leasingOfficeSchema(locale)]}>
  <HeroEditorial locale={locale} {...p.hero} />
  <Philosophy locale={locale} {...p.philosophy} summary={p.summary} />
  <Features locale={locale} label={p.features.label} heading={p.features.heading} items={p.features.items} />
  <SuiteIndex locale={locale} {...p.suiteIndex} />
  <ImageBand locale={locale} {...p.band} />
  <GallerySlider locale={locale} {...p.slider} />
  <CtaStatement locale={locale} heading={p.cta.heading} />
  <NextPage locale={locale} page={nextPage('home')} {...p.next} />
</BaseLayout>
