---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import HeroPage from '../../components/sections/HeroPage.astro';
import Philosophy from '../../components/sections/Philosophy.astro';
import BigList from '../../components/sections/BigList.astro';
import Features from '../../components/sections/Features.astro';
import GallerySlider from '../../components/sections/GallerySlider.astro';
import CtaStatement from '../../components/sections/CtaStatement.astro';
import NextPage from '../../components/sections/NextPage.astro';
import { getPage } from '../../lib/content';
import { getLocalePaths } from '../../lib/paths';
import { nextPage, t, l, formatDate } from '../../lib/i18n';
import { breadcrumbSchema } from '../../lib/schema';
import type { Locale } from '../../i18n/ui';

export const getStaticPaths = getLocalePaths;
const locale = Astro.params.lang as Locale;
const p = await getPage<any>(locale, 'lifestyle');
const events = (await getCollection('events')).sort((a, b) => a.data.date.localeCompare(b.data.date));
const rows = events.map((e) => ({ value: formatDate(e.data.date, locale), name: l(e.data.title, locale), label: l(e.data.location, locale) }));
---
<BaseLayout locale={locale} title={p.seo.title} description={p.seo.description} schema={breadcrumbSchema(locale, 'lifestyle', t(locale, 'nav.lifestyle'))}>
  <HeroPage locale={locale} {...p.hero} />
  <Philosophy locale={locale} {...p.philosophy} summary={p.summary} />
  <section class="container-site pb-24 md:pb-32">
    <div class="mb-8 flex items-end justify-between gap-4"><h2 class="text-paren text-ink-soft">{p.events.label}</h2><p class="text-sm text-ink-soft">{p.events.note}</p></div>
    <BigList rows={rows} valueFirst />
  </section>
  <Features locale={locale} items={p.features.items} muted />
  <GallerySlider locale={locale} {...p.slider} />
  <CtaStatement locale={locale} heading={p.cta.heading} />
  <NextPage locale={locale} page={nextPage('lifestyle')} {...p.next} />
</BaseLayout>
