---
import '../styles/global.css';
import site from '../config/site.json';
import figtreeUrl from '@fontsource-variable/figtree/files/figtree-latin-wght-normal.woff2?url';
import frauncesUrl from '@fontsource-variable/fraunces/files/fraunces-latin-wght-normal.woff2?url';
import PageTransition from '../components/layout/PageTransition.astro';
import PromoModal from '../components/layout/PromoModal.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import { locales, localeTag, switchLocalePath, t, pageOrder, pagePath } from '../lib/i18n';
import type { Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  image?: string;
  schema?: Record<string, any> | Record<string, any>[];
  headerOverlay?: boolean;
  noindex?: boolean;
}
const { locale, title, description, image, schema, headerOverlay = true, noindex = false } = Astro.props;
// Name shown on the transition curtain when this page is reached with the browser's back/forward buttons
const currentPath = Astro.url.pathname.replace(/\/?$/, '/');
const pageKey = pageOrder.find((pg) => pagePath(locale, pg) === currentPath);
const vtPage = !pageKey || pageKey === 'home' ? site.name : t(locale, `nav.${pageKey}`);
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = image ?? 'https://images.unsplash.com/photo-1600210491892-03d54c0aaf87?auto=format&fit=crop&w=1200&h=630&q=75';
const schemas = schema ? (Array.isArray(schema) ? schema : [schema]) : [];
const gtm = site.analytics.gtmId;
---
<!doctype html>
<html lang={localeTag[locale]} class="no-js" data-vt-page={vtPage}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {locales.map((lc) => <link rel="alternate" hreflang={localeTag[lc]} href={new URL(switchLocalePath(Astro.url.pathname, lc), Astro.site)} />)}
    <link rel="alternate" hreflang="x-default" href={new URL(switchLocalePath(Astro.url.pathname, 'en'), Astro.site)} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={localeTag[locale].replace('-', '_')} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#1f1f1d" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://images.unsplash.com" crossorigin />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {schemas.map((s) => <script type="application/ld+json" is:inline set:html={JSON.stringify(s)} />)}
    <script is:inline>document.documentElement.classList.replace('no-js', 'js');</script>
    <!-- Preload the display + serif fonts so the transition curtain text never paints in a fallback font -->
    <link rel="preload" href={figtreeUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={frauncesUrl} as="font" type="font/woff2" crossorigin />
    <script is:inline>
      // Page transitions: arriving from an internal link (or via back/forward), start covered by the curtain (before first paint),
      // then start the reveal once the page has parsed and the display font is ready (capped, so it never hangs).
      try {
        var d = document.documentElement;
        // Arrived with the browser's back/forward buttons (a fresh load; pages restored from the back/forward cache are handled in PageTransition.astro)
        var nav = performance.getEntriesByType && performance.getEntriesByType('navigation')[0];
        var back = nav ? nav.type === 'back_forward' : (performance.navigation && performance.navigation.type === 2);
        if ((sessionStorage.getItem('vt') === '1' || back) && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
          d.classList.add('vt-arrive');
          if (back && sessionStorage.getItem('vt') !== '1') d.setAttribute('data-vt-back', '');
          var revealed = false;
          var reveal = function () { if (revealed) return; revealed = true; requestAnimationFrame(function () { requestAnimationFrame(function () { d.classList.add('vt-reveal'); }); }); };
          document.addEventListener('DOMContentLoaded', function () {
            if (document.fonts && document.fonts.ready) { document.fonts.ready.then(reveal); setTimeout(reveal, 350); } else { reveal(); }
          });
          setTimeout(reveal, 1500);
        }
        sessionStorage.removeItem('vt');
      } catch (e) {}
    </script>
    {gtm && (
      <script is:inline define:vars={{ gtm }}>
        // GTM loads only after consent. Wire this to the client's consent banner.
        window.loadAnalytics = () => { (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s);j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i;f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer',gtm); };
      </script>
    )}
  </head>
  <body class="bg-page text-ink">
    <PageTransition />
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:rounded-full focus:bg-ink focus:px-5 focus:py-3 focus:text-page">{t(locale, 'nav.skip')}</a>
    <Header locale={locale} overlay={headerOverlay} />
    <main id="main">
      <slot />
    </main>
    <Footer locale={locale} />
    {pageKey === 'home' && <PromoModal locale={locale} />}
    <script>
      // Reveal-on-scroll for [data-reveal] elements
      const io = new IntersectionObserver((entries) => {
        for (const e of entries) if (e.isIntersecting) { e.target.classList.add('is-visible'); io.unobserve(e.target); }
      }, { rootMargin: '0px 0px -10% 0px' });
      document.querySelectorAll('[data-reveal]').forEach((el) => io.observe(el));
    </script>
    <script>import '../scripts/parallax';</script>
  </body>
</html>
