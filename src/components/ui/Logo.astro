---
import site from '../../config/site.json';
import Icon from './Icon.astro';
interface Props { class?: string; }
const { class: cls = '' } = Astro.props;
---
<span class:list={['inline-flex items-center gap-2.5 font-serif text-[1.375rem] leading-none tracking-[-0.01em] md:text-2xl', cls]}>
  <Icon name="mark" size={18} class="text-accent" />
  <span>{site.name}</span>
</span>
