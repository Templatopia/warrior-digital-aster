---
import Photo from '../ui/Photo.astro';
import Button from '../ui/Button.astro';
import Marquee from './Marquee.astro';
import { t, pagePath } from '../../lib/i18n';
import type { Locale } from '../../i18n/ui';
import type { PhotoKey } from '../../data/photos';
interface Props { locale: Locale; photo: PhotoKey; title: string; eyebrow: string; subline: string; }
const { locale, photo, title, eyebrow, subline } = Astro.props;
---
<section class="relative isolate flex h-[88svh] min-h-[600px] max-h-[860px] flex-col justify-end overflow-hidden bg-inverse text-cream">
  <Photo photo={photo} locale={locale} eager class="absolute inset-0 -z-20 h-full w-full" />
  <div class="absolute inset-0 -z-10 bg-[linear-gradient(180deg,rgb(20_20_18/0.5)_0%,rgb(20_20_18/0.1)_35%,rgb(20_20_18/0.72)_100%)]"></div>
  <h1 class="sr-only">{title}</h1>
  <Marquee text={title} class="text-mega absolute inset-x-0 top-[28%]" still />
  <div class="container-site relative flex flex-col gap-6 pb-8 md:flex-row md:items-end md:justify-between md:pb-14">
    <div class="max-w-md space-y-3">
      <p class="text-paren">{eyebrow}</p>
      <p class="text-body-l">{subline}</p>
    </div>
    <Button href={pagePath(locale, 'contact')} size="sm" class="self-start md:self-auto">{t(locale, 'cta.bookTour')}</Button>
  </div>
</section>
