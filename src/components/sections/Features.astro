---
import FeatureRow from './FeatureRow.astro';
import SectionHead from './SectionHead.astro';
import type { Locale } from '../../i18n/ui';
interface Props { locale: Locale; items: any[]; label?: string; heading?: string; muted?: boolean; }
const { locale, items, label, heading, muted = false } = Astro.props;
---
<section class:list={['py-24 md:py-40', muted && 'bg-muted']}>
  <div class="container-site space-y-24 md:space-y-40">
    {label && heading && <SectionHead label={label} heading={heading} />}
    {items.map((it, i) => <FeatureRow locale={locale} {...it} side={i % 2 === 0 ? 'left' : 'right'} />)}
  </div>
</section>
