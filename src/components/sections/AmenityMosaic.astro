---
import { getCollection } from 'astro:content';
import Photo from '../ui/Photo.astro';
import { l } from '../../lib/i18n';
import { byOrder } from '../../lib/content';
import type { Locale } from '../../i18n/ui';
interface Props { locale: Locale; }
const { locale } = Astro.props;
const items = (await getCollection('amenities')).sort(byOrder);
// Mosaic rhythm: wide + narrow, three across, two across
const layout = ['md:col-span-8 aspect-[4/3] md:aspect-auto md:h-[560px]', 'md:col-span-4 aspect-[4/3] md:aspect-auto md:h-[560px]', 'md:col-span-4 aspect-[4/3] md:h-[460px] md:aspect-auto', 'md:col-span-4 aspect-[4/3] md:h-[460px] md:aspect-auto', 'md:col-span-4 aspect-[4/3] md:h-[460px] md:aspect-auto', 'md:col-span-6 aspect-[4/3] md:h-[440px] md:aspect-auto', 'md:col-span-6 aspect-[4/3] md:h-[440px] md:aspect-auto'];
const span = (cls: string) => cls.split(' ').filter((c) => c.includes('col-span')).join(' ');
const media = (cls: string) => cls.split(' ').filter((c) => !c.includes('col-span')).join(' ');
---
<ul class="mt-16 grid grid-cols-2 gap-x-4 gap-y-12 md:grid-cols-12 md:gap-x-10 md:gap-y-20">
  {items.map((a, i) => (
    <li class:list={['space-y-4', i < 2 ? 'col-span-2' : 'col-span-1', span(layout[i % layout.length])]} data-reveal>
      <div class:list={['overflow-hidden', media(layout[i % layout.length])]}>
        <Photo photo={a.data.photo} locale={locale} sizes="(min-width: 768px) 60vw, 100vw" class="h-full w-full" />
      </div>
      <div class="space-y-2">
        <h3 class:list={[i < 2 ? 'text-feature' : 'font-serif text-xl md:text-feature']}>{l(a.data.name, locale)}</h3>
        <p class="text-label-ext text-accent">{l(a.data.location, locale)}</p>
      </div>
      <p class="text-sm text-ink-soft md:text-base">{l(a.data.blurb, locale)}</p>
    </li>
  ))}
</ul>
