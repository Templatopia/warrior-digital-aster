---
import FloorplanCard from './FloorplanCard.astro';
import Icon from '../ui/Icon.astro';
import SuiteModals from './SuiteModals.astro';
import { getSuites } from '../../lib/content';
import { t, formatPrice } from '../../lib/i18n';
import type { Locale } from '../../i18n/ui';
interface Props { locale: Locale; note?: string; }
const { locale, note } = Astro.props;
const suites = await getSuites();

// Suite type dropdown: only types that exist in the data, in data order
const types = [...new Set(suites.map((s) => s.data.type))];

// Price slider bounds, rounded out to the nearest $50
const STEP = 50;
const prices = suites.map((s) => s.data.priceFrom);
const minPrice = Math.floor(Math.min(...prices) / STEP) * STEP;
const maxPrice = Math.ceil(Math.max(...prices) / STEP) * STEP;
---
<div data-floorplans data-locale={locale} data-min={minPrice} data-max={maxPrice} data-subject={t(locale, 'inquiry.subject')}>
  <div class="grid gap-6 border-y border-line py-6 md:grid-cols-[minmax(0,260px)_minmax(0,420px)_1fr] md:items-start md:gap-10">
    <div>
      <label for="suite-type" class="text-label-ext mb-3 block leading-4 text-ink-soft">{t(locale, 'filter.type')}</label>
      <div class="relative">
        <select id="suite-type" data-type-select class="w-full cursor-pointer appearance-none rounded-full border border-line bg-surface py-2.5 pr-11 pl-5 text-sm font-medium transition-colors hover:border-ink focus-visible:border-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink">
          <option value="all">{t(locale, 'filter.allTypes')}</option>
          {types.map((ty) => <option value={ty}>{t(locale, `suite.type.${ty}` as any)}</option>)}
        </select>
        <Icon name="chevron-down" size={16} class="pointer-events-none absolute top-1/2 right-4 -translate-y-1/2" />
      </div>
    </div>

    <div role="group" aria-labelledby="price-label">
      <div class="mb-3 flex items-end justify-between gap-4 leading-4">
        <span id="price-label" class="text-label-ext leading-4 text-ink-soft">{t(locale, 'filter.price')}</span>
        <span class="text-sm leading-4 font-medium tabular-nums" data-price-out aria-live="polite">{formatPrice(minPrice, locale)} – {formatPrice(maxPrice, locale)}</span>
      </div>
      <div class="price-range md:mt-[21px]" data-price-range style={`--lo:0%;--hi:100%`}>
        <span class="price-range__track" aria-hidden="true"><span class="price-range__fill"></span></span>
        <input type="range" data-price-min min={minPrice} max={maxPrice} step={STEP} value={minPrice} aria-label={t(locale, 'filter.priceMin')} />
        <input type="range" data-price-max min={minPrice} max={maxPrice} step={STEP} value={maxPrice} aria-label={t(locale, 'filter.priceMax')} />
      </div>
    </div>

    <p class="text-sm md:self-end md:justify-self-end md:pb-2.5" aria-live="polite"><span data-count>{suites.length}</span> {t(locale, 'filter.count')}</p>
  </div>
  <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3 lg:gap-10" data-grid>
    {suites.map((s) => <FloorplanCard locale={locale} suite={s} />)}
  </div>
  <div class="mt-10 hidden border border-line p-10 text-center" data-empty>
    <p class="text-ink-soft">{t(locale, 'filter.empty')}</p>
    <button type="button" class="mt-4 font-semibold underline underline-offset-4" data-reset>{t(locale, 'filter.reset')}</button>
  </div>
  {note && <p class="mt-8 text-sm text-ink-soft">{note}</p>}
  <SuiteModals locale={locale} />
</div>

<style>
  /* Two-handle price slider: two native range inputs stacked on one track (keyboard + screen-reader friendly). */
  .price-range { position: relative; height: 24px; }
  .price-range__track { position: absolute; top: 50%; left: 0; right: 0; height: 2px; transform: translateY(-50%); background: var(--ma-line); border-radius: 2px; }
  .price-range__fill { position: absolute; top: 0; bottom: 0; left: var(--lo); right: calc(100% - var(--hi)); background: var(--ma-ink); }
  .price-range input {
    position: absolute; inset: 0; width: 100%; height: 100%; margin: 0;
    -webkit-appearance: none; appearance: none; background: none; pointer-events: none;
  }
  .price-range input:focus { outline: none; }
  .price-range input::-webkit-slider-runnable-track { background: none; height: 24px; }
  .price-range input::-moz-range-track { background: none; }
  .price-range input::-webkit-slider-thumb {
    -webkit-appearance: none; appearance: none; pointer-events: auto; cursor: grab;
    width: 20px; height: 20px; margin-top: 2px; border-radius: 50%;
    background: var(--ma-ink); border: 3px solid var(--ma-surface); box-shadow: 0 0 0 1px var(--ma-ink);
    transition: transform 0.2s ease;
  }
  .price-range input::-moz-range-thumb {
    pointer-events: auto; cursor: grab; width: 14px; height: 14px; border-radius: 50%;
    background: var(--ma-ink); border: 3px solid var(--ma-surface); box-shadow: 0 0 0 1px var(--ma-ink);
    transition: transform 0.2s ease;
  }
  .price-range input:active::-webkit-slider-thumb { cursor: grabbing; transform: scale(1.15); }
  .price-range input:active::-moz-range-thumb { cursor: grabbing; transform: scale(1.15); }
  .price-range input:focus-visible::-webkit-slider-thumb { box-shadow: 0 0 0 1px var(--ma-ink), 0 0 0 4px color-mix(in srgb, var(--ma-ink) 25%, transparent); }
  .price-range input:focus-visible::-moz-range-thumb { box-shadow: 0 0 0 1px var(--ma-ink), 0 0 0 4px color-mix(in srgb, var(--ma-ink) 25%, transparent); }
</style>

<script>
  import { animateFilter } from '../../lib/filterAnimate';
  const root = document.querySelector<HTMLElement>('[data-floorplans]');
  if (root) {
    const locale = root.dataset.locale === 'fr' ? 'fr-CA' : 'en-CA';
    const fmt = new Intl.NumberFormat(locale, { style: 'currency', currency: 'CAD', maximumFractionDigits: 0 });
    const MIN = Number(root.dataset.min), MAX = Number(root.dataset.max);
    const cards = [...root.querySelectorAll<HTMLElement>('[data-suite]')];
    const select = root.querySelector<HTMLSelectElement>('[data-type-select]')!;
    const lo = root.querySelector<HTMLInputElement>('[data-price-min]')!;
    const hi = root.querySelector<HTMLInputElement>('[data-price-max]')!;
    const range = root.querySelector<HTMLElement>('[data-price-range]')!;
    const out = root.querySelector<HTMLElement>('[data-price-out]')!;

    // Deep links from the home page suite index: /suites/?type=2bed
    const param = new URLSearchParams(location.search).get('type');
    if (param && [...select.options].some((o) => o.value === param)) select.value = param;

    const matches = (c: HTMLElement) => {
      const price = Number(c.dataset.price);
      return (select.value === 'all' || c.dataset.type === select.value) && price >= Number(lo.value) && price <= Number(hi.value);
    };
    const pct = (v: number) => `${((v - MIN) / (MAX - MIN)) * 100}%`;
    const paintSlider = () => {
      range.style.setProperty('--lo', pct(Number(lo.value)));
      range.style.setProperty('--hi', pct(Number(hi.value)));
      out.textContent = `${fmt.format(Number(lo.value))} – ${fmt.format(Number(hi.value))}`;
      lo.setAttribute('aria-valuetext', fmt.format(Number(lo.value)));
      hi.setAttribute('aria-valuetext', fmt.format(Number(hi.value)));
      // Whichever handle is nearer the right edge sits on top, so both stay grabbable when they meet
      lo.style.zIndex = Number(lo.value) > MIN + (MAX - MIN) / 2 ? '3' : '1';
      hi.style.zIndex = '2';
    };
    const apply = (animate = true) => {
      const n = cards.filter(matches).length;
      root.querySelector('[data-count]')!.textContent = String(n);
      const empty = () => root.querySelector('[data-empty]')!.classList.toggle('hidden', n > 0);
      if (animate) animateFilter(cards, matches, empty);
      else { cards.forEach((c) => (c.hidden = !matches(c))); empty(); }
    };

    select.addEventListener('change', () => {
      const url = new URL(location.href);
      select.value === 'all' ? url.searchParams.delete('type') : url.searchParams.set('type', select.value);
      history.replaceState(null, '', url);
      apply();
    });

    // Slider: handles can't cross; the list updates shortly after the handle stops moving
    let timer = 0;
    const onSlide = (e: Event) => {
      if (Number(lo.value) > Number(hi.value)) (e.target === lo ? (lo.value = hi.value) : (hi.value = lo.value));
      paintSlider();
      clearTimeout(timer);
      timer = window.setTimeout(apply, 220);
    };
    lo.addEventListener('input', onSlide);
    hi.addEventListener('input', onSlide);

    root.querySelector('[data-reset]')?.addEventListener('click', () => {
      select.value = 'all'; lo.value = String(MIN); hi.value = String(MAX);
      const url = new URL(location.href); url.searchParams.delete('type'); history.replaceState(null, '', url);
      paintSlider(); apply();
    });

    paintSlider();
    apply(false);
  }
</script>
